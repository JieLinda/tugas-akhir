NEXT_PUBLIC_BASE_PATH=
# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulse

# Auth - Keycloak = SSO / login ONLY (identity). Roles are NOT taken from
# Keycloak — they are fully managed in-app (Settings ▸ Peran & Akses). Leave
# empty to run locally as the admin System User.
#
# RBAC bootstrap (escape hatch, no lockout): comma-separated emails that always
# have full admin access regardless of DB roles. Set this to your own email(s)
# for the first login so you can create/assign roles. The local System User is
# always admin too.
RBAC_ADMIN_EMAILS=
KEYCLOAK_CLIENT_ID=ai-portal-client
KEYCLOAK_CLIENT_SECRET=XsyUBY3U7xIAvVqayTGNirNUjj469IOS
KEYCLOAK_ISSUER=https://dev-nms-keycloak.mpm-motor.com/realms/ai-app

# NextAuth
AUTH_SECRET=4bbd2d1378a0ce807e5e94921f10d7c1405f5da569cd962784089bd5206624aa
AUTH_URL=https://dev-aira.mpm-motor.com/tuturaksara
AUTH_TRUST_HOST=true

# Keycloak Configuration
KEYCLOAK_CLIENT_ID=ai-portal-client
KEYCLOAK_CLIENT_SECRET=XsyUBY3U7xIAvVqayTGNirNUjj469IOS
KEYCLOAK_ISSUER=https://dev-nms-keycloak.mpm-motor.com/realms/ai-app

# Portal API (optional - for org data)
PORTAL_API_URL=https://dev-aira.mpm-motor.com
INTERNAL_API_TOKEN=d37cf0543b9ba6338b45c21f

# LLM (OpenAI-compatible endpoint: AI Assistant chat, job-family matching, kamus)
LLM_BASE_URL=https://models.mpm-motor.com/v1
LLM_MODEL=vllm/aira
LLM_API_KEY=
VISI_MODEL=vllm/aira-vision

# Google Gemini (optional — for AI prompt generation with search)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Internal services (used by Next.js API routes as proxy targets)
SYNC_SERVICE_URL=http://localhost:8000
SCORING_SERVICE_URL=http://localhost:8002
# Python topic-service — BERTopic job-family clustering (UMAP/HDBSCAN/c-TF-IDF).
TOPIC_SERVICE_URL=http://localhost:8003

# ── Vector DB (pgvector) & Embedding API ──
# Vector embeddings (Job Family & Kamus) are stored in a dedicated PostgreSQL + pgvector database container.
VECTOR_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pulse_vectors

# Job Family / Kamus DOCUMENT embeddings come from one of 3 sources, selectable
# per-tenant on the Job Family Configuration page ("Sumber Model"):
#   1. multilingual  — Xenova/multilingual-e5-base via scoring-service
#                       (Transformers.js; set EMBEDDING_MODEL in scoring-service/.env, not here)
#   2. nomic-local    — Nomic via a local OpenAI-compatible endpoint (e.g. Ollama)
#   3. nomic-remote   — Nomic via a remote/hosted OpenAI-compatible endpoint

# Source 2: Nomic — local (e.g. `ollama serve` on this machine)
EMBEDDING_API_BASE=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
EMBEDDING_API_KEY=

# Source 3: Nomic — remote/hosted API server
EMBEDDING_API_BASE_REMOTE=https://models.mpm-motor.com/v1
EMBEDDING_MODEL_REMOTE=ollama/nomic-embed-text-v2-moe:latest
EMBEDDING_API_KEY_REMOTE=

# ── App mode (docs/mode-demo.md) ─────────────────────────────────────────
# Mode for a browser that has not switched with ?mode=. Read at RUNTIME, so a
# restart applies it — no rebuild. demo | asli (default: asli).
# PULSE_DEFAULT_MODE=demo
# 1 = ignore ?mode= entirely; every browser is always in the default mode. Set
# both on a demo deployment that must not be switchable to real data by URL.
# PULSE_MODE_LOCKED=1
