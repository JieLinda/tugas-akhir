PORT=8002
POSTGRES_URL=postgresql://user:password@localhost:5432/pulse

# ── Encryption (master key) ──
# Candidate PII is sealed at rest with AES-256-GCM envelope encryption by the web
# app. This service unwraps the DEK from the master key file on first read and
# holds it in memory; it never writes key material. Get this wrong and nothing
# fails loudly — the sealed columns simply read as NULL, which silently flattens
# the behavior, education, HAV and performance aspects of every AHP+TOPSIS run.
# Path resolves against the process cwd. In docker-compose the ./secrets dir is
# bind-mounted read-only and this is set to /app/secrets/master.key.
PULSE_MASTER_KEY_FILE=../secrets/master.key
# Alternative for env-injected secrets (inline base64 32-byte key). Takes effect
# only when the file above is absent/unreadable.
# PULSE_MASTER_KEY=
# Config files the WEB APP owns and this service reads. Resolved automatically
# for a repo checkout (../lib) and for Docker (/app/lib, bind-mounted by
# docker-compose). Set these only when the files live somewhere else.
# SCORING_PROMPTS_PATH=/app/lib/scoring-prompts.json
# READINESS_CONFIG_PATH=/app/lib/readiness-config.json
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=not-needed
LLM_MODEL=default
# Parallel LLM calls for the per-finalist AHP+TOPSIS insight writing
INSIGHT_LLM_CONCURRENCY=3

# ── AHP+TOPSIS insight notes ──
# Whether the finalists of an AHP+TOPSIS run get LLM-written insight bullets
# (Keunggulan Kompetitif / Kebutuhan Pengembangan / Arahan Langkah Suksesi &
# Penugasan) instead of the deterministic per-aspect templates. The templates name
# no competency and no assignment, so they read the same for every candidate below
# a threshold; the agent is handed the Hungarian competency gaps, the career stint
# matches and the education reasoning and writes from those.
# The RANKING is identical either way: the agent runs after the scores are fixed,
# is given them as read-only context, and nothing it returns is read back into a
# score, a rank or a readiness band. One call per finalist, at
# INSIGHT_LLM_CONCURRENCY above; a failed call falls back to the template for that
# candidate alone and the mix is reported in runInfo.narrative.
# A DEMO-mode run never calls the writer: its finalists keep the templates.
# Uses LLM_BASE_URL / LLM_MODEL / LLM_API_KEY and LLM_INSIGHT_TEMPERATURE.
# Guideline is editable in Tata Kelola (prompt key: ahp_narrative_agent).
AHP_NARRATIVE_LLM=true
# Sampling temperature for the insight writer
LLM_INSIGHT_TEMPERATURE=0.7

# ── AHP + TOPSIS method ──
# PRIMARY embedding model — technical & career-relevance similarity AND the
# position_name <-> job-profile fuzzy match. Defaults to Nomic Embed Text v2 MoE
# over an OpenAI-compatible endpoint: the SAME model and transport the web app's
# Job Family rebuild uses (lib/job-family/embed.ts), because every stored vector
# this service compares against (job_profile_embed, kamus_kompetensi_level_embed)
# is written there. A different model puts the two sides in different spaces and
# makes every cosine meaningless.
EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
# Transport: openai|ollama|api -> OpenAI-compatible /v1/embeddings.
# transformers -> in-process ONNX (@xenova/transformers), no server needed.
EMBEDDING_PROVIDER=openai
# OpenAI-compatible base URL (EMBEDDING_BASE_URL is still read for compatibility)
EMBEDDING_API_BASE=http://localhost:11434/v1
# Bearer token for hosted gateways; local Ollama needs none.
# EMBEDDING_API_KEY=
# DOCUMENT embedding model — used ONLY for the topic-modelling DOCUMENT vectors
# (restructured job-profile paragraphs + kamus-kompetensi documents). Defaults to
# EMBEDDING_MODEL so both stay in one space.
# (Legacy env EMBEDDING_MODEL_JOB_FAMILY is still read as a fallback.)
# DOCUMENT_EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
# ── transformers provider only ──
# Load quantized (int8) ONNX weights (default true). Set to false when a model
# repo only ships the full-precision onnx/model.onnx (no model_quantized.onnx) —
# nomic-embed-text-v2-moe has NO quantized export and 404s under the default.
# EMBEDDING_QUANTIZED=true
# Optional: where to cache the downloaded model(s) (defaults to the library cache)
# EMBEDDING_CACHE_DIR=./.model-cache

# ── Technical: level-factor policy numbers ──
# A pairing's cell value is `similarity × levelFactor`. Two policy knobs shape
# levelFactor (both are judgement calls, not measured quantities):
#
# Over-qualification surplus for IDENTITY pairs (same competency by name or kamus
# code) when the candidate's level EXCEEDS what the job demands:
#   levelFactor = min(1 + SURPLUS × (k − t) / 3, 1 + SURPLUS)
# 0.75 → ceiling 1.75. Raised from 0.25/1.25: at +25% a candidate three levels
# clear of the requirement was worth barely more than one who merely met it, so
# depth of mastery hardly showed in the score. Similarity pairs stay capped at
# 1.0 regardless, so this also widens the gap between holding a competency and
# merely resembling one. Σ/M can now reach ~1.75, i.e. a Technical score can read
# above 100 — the raw value feeds TOPSIS, the displayed bar is clipped.
# TECHNICAL_OVERQUALIFICATION_SURPLUS=0.75
#
# Shortfall span when the candidate's level is BELOW the requirement:
#   levelFactor = max(0, 1 − (t − k) / SPAN)
# 4, not 3, so the worst possible shortfall still keeps a quarter of the credit —
# holding a competency three levels short is not the same as not holding it.
# TECHNICAL_LEVEL_GAP_SPAN=4

# ── Career relevance: incumbent-competency fallback calibration ──
# A history position with no job profile is scored by matching that position's
# INCUMBENT competencies against the target's reference set, producing a 0..1
# coverage ratio that is then mapped onto the document-similarity scale.
#
# UNSET IS THE RIGHT SETTING. Unset means "use the run's MEASURED Career scale"
# (see below), so coverage 0 lands exactly where an unrelated document lands.
# Setting these PINS the band and disables the cap below.
# CAREER_FALLBACK_ANCHOR_LO=
# CAREER_FALLBACK_ANCHOR_HI=
#
# THE CAP: how much relevance FULL competency coverage may assert, as a fraction
# of the measured band. Coverage 1.0 reaches floor + CAP x (ceil - floor), i.e.
# sim' = CAP and no further.
#
# This replaced a per-run p5..p95 band whose comment promised that a fallback
# "must not out-score a real document match" and whose implementation did the
# opposite: p95 of the few dozen stints a run matches is very nearly their
# maximum, so on the IT Application Development Department Head run the band came
# out [0.563, 0.949] -- and 0.949 is exactly that target's cosine against its own
# "IT Application Development Analyst" JD. Full competency coverage bought the
# claim "this IS the job".
#
# 0.5 is measured, not round: the fallback signal separates job families at AUC
# 0.743 against the document cosine's 0.874, and 5% of UNRELATED job pairs share
# >= 75% of their competencies. Lower it to trust the fallback less.
# CAREER_FALLBACK_CAP=0.5
#
# Weight each required competency by ln(N/df) over the job-profile corpus instead
# of counting them all equally. Needed because the vocabulary is dominated by
# near-universal entries -- SOFTWARE APPLICATION OPERATION appears on 92.7% of
# 275 JDs, PRODUCT AND SERVICE KNOWLEDGE on 92.4% -- so an unrelated manager
# covered ~45% of any position's requirements for being a manager at all.
# Measured: the median coverage of an unrelated job pair falls 0.286 -> 0.104.
# Set to 0 only if the corpus is too small for df to mean anything.
# CAREER_FALLBACK_IDF=1

# -- Career relevance: similarity scale --
# A raw cosine is not a percentage. Every stint similarity is stretched onto a
# true 0..1 between a floor ("no closer than an unrelated job profile") and a
# ceiling ("effectively the same job"):
#   sim' = clamp((sim - FLOOR) / (CEIL - FLOOR), 0, 1)
#
# LEAVE THESE UNSET. The values are MEASURED and cached in
# job_profile_similarity_calibration, and recomputed by themselves whenever ANY
# input the estimators read changes. The fingerprint covers four things:
#   md5(job_profile_id, content_hash) -- a JD's text changed, or one was added
#   model                             -- same documents, different space
#   t<topicRun>/<n>                   -- the job families were re-clustered
#   h<historyHash>                    -- candidate_position_history moved (the
#                                        weekly HR sync); hashed over the ordered
#                                        (candidate, position, valid_from) set,
#                                        because a corrected date reorders a
#                                        career and changes which pairs are moves
#   METHOD_VERSION                    -- what the estimators compute changed
# The last three were added after an earlier version tracked only the first two
# and argued the label-based estimators were "stable in aggregate" -- wrong in the
# way that matters, since a re-clustering reassigns every topic id and the failure
# is invisible (200 response, completed run, stale scale).
#
# ONE change no fingerprint can see: a re-embed producing different VECTORS from
# the same text with the same model (a re-tuned embedding service, a half-finished
# earlier run). content_hash covers text+model only, which is why
# rebuildJobProfileEmbeddings re-embeds unconditionally -- so it calls
# POST /api/embed/career-anchors/refresh?force=1 rather than relying on detection.
#
# Three independent estimators answer the same question and the MEDIAN wins, so no
# single one can move the scale alone:
#
#   corpus      p25 of arbitrary cross-document pairs / p99 of each document's
#               nearest genuine twin. Needs no labels, so always available.
#               Measured here: 0.519 - 0.998.
#   family      the cosine at which P(same job family) crosses 50% / 95%, against
#               the last completed topic run. Measured: 0.672 - 0.878. Partly
#               circular -- those families were clustered from these vectors.
#   transitions REVEALED PREFERENCE: percentiles of the cosine distribution of
#               internal moves people ACTUALLY MADE (p10 / p75). The only
#               non-circular estimator. Measured over 102 real moves:
#               0.633 - 0.892.
#
#   resolved median on this deployment: 0.633 - 0.892
#
# WHY THIS REPLACED "p25 of arbitrary pairs" ALONE. At cosine 0.519 -- the floor
# that produced -- the probability two profiles are even in the same job family
# is 10%. So sim' = 0 sat where 90% of pairs are unrelated and everything above
# earned positive relevance; career multiplies sim' by years and ACCUMULATES, so
# a 12-year unrelated career banked ~4.7 "effective relevant years". Measured
# over 660 scored candidates: document-scored candidates averaged 35.1 while
# fallback-scored ones averaged 66.7.
#
# Setting these PINS the scale and skips the census entirely. Each run records
# what it used, including the estimator breakdown, in runInfo.career.scale.
# CAREER_SIM_FLOOR=
# CAREER_SIM_CEIL=

# -- Career relevance: experience depth --
# Relevant experience is ACCUMULATED, not averaged, and decayed by age:
#   recency  = exp(-DECAY x years since the stint ENDED)   (1 while ongoing)
#   effYears = Sigma(sim' x years x recency)
#   effRows  = Sigma(sim' x recency)
#   score    = sat(effYears/T_years) x (1 - W + W x sat(effRows/T_rows)) x 100
#
# T IS ABSOLUTE. It used to be median-of-pool x 2, which made career the only
# pool-relative quantity among the six aspects -- and gave it a fatal corollary:
# the yardstick shrank exactly when the bench was weakest. Measured, on runs that
# are in the database now: a Learning & Development pool whose average relevance
# was 0.168 produced T = 2.06 years / 1.0 stints (the second pinned at its clamp
# floor, so ONE stint saturated that axis) and averaged 33.1; against a fixed 8/2
# the same people score 11.3. The inflation ran 1.4x on a normal pool and 3x on a
# bad one, always toward making a weak bench look viable.
#
# WHERE T_years COMES FROM, in precedence order:
#   1. inherited  -- an incremental run reuses the base run's target.
#   2. jd         -- the target job profile's own jobSpecification.experience,
#                    turned into a target by CAREER_DEPTH_STATED_MODE below.
#   3. measured   -- median years of service of the people ACTUALLY APPOINTED to a
#                    job at the target's seniority band, from
#                    candidate_position_history (career-depth-anchors.ts). Used
#                    when the JD says nothing usable -- "Fresh graduate" (78 of 275
#                    profiles), unparseable text (23 more), or NO job profile at
#                    all. Measured here: Staff 5.1 - Officer/Analyst 6.7 -
#                    Section Head/SPV 8.0 - Dept Head/Manager 9.25 - Div Head/GM
#                    15.9. Monotonic by construction: a thin senior band is raised
#                    to the most demanding junior band rather than allowed to end
#                    up EASIER than one.
#   4. constant   -- CAREER_DEPTH_TARGET_YEARS below. The only number in the whole
#                    career criterion not derived from data.
#
# "measured" (default) or "constant" -- set constant only if the appointment
# history is unusable on this deployment.
# CAREER_DEPTH_DEFAULT_SOURCE=measured
#
# How a JD's stated minimum becomes a target:
#   scaled (default) -- stated x CAREER_DEPTH_STATED_MULTIPLIER
#   direct           -- stated as-is
#   ignore           -- never read the JD; always use the source above
#
# THE UNIT PROBLEM, which decides this setting. A JD means raw calendar years in
# one named role ("Min 5 tahun sebagai Application Developer"). effectiveYears
# discounts every year by relevance (sim') and by age (recency). Measured median
# ratio on this deployment: effectiveYears / years-that-scored = 0.398. So the
# honest translation of "5 years" is 5 / 0.398 = 12.6 effective years, and
# "direct" implements roughly 40% of the document -- more lenient, not more
# faithful. Measured separation between genuine and spurious relevance on the
# reference run: T=2/3 -> 3 points, T=5 -> 9, T=8 -> 40, T=10 -> 45 (peak),
# T=12 -> 38.
# CAREER_DEPTH_STATED_MODE=scaled
#
# The saturation target, in effective relevant years. NOT an eligibility minimum,
# and only the LAST resort -- see the precedence list above.
# CAREER_DEPTH_TARGET_YEARS=8
# Effective relevant assignments. 2 rather than 3 because at 3 the breadth axis
# punished the very profile this criterion should reward: a decade in the exact
# target job, held as ONE assignment, reached only 1.4 effective stints.
# CAREER_DEPTH_TARGET_ROWS=2
#
# Where the target job profile states its own requirement ("Min 5 tahun sebagai
# Application Developer" -- parseable on 179 of 279 profiles), that number x this
# becomes the target. 1 = the requirement AS WRITTEN is the full-score point.
#
# It was 2, on the argument that a stated requirement is a minimum to be eligible
# rather than the point deserving 100. It is 1 because doubling was this service
# overruling the JD -- a seat asking for 3 years had its bar set at 6 -- and
# because the feared effect is milder than it sounds: measured over 1,784
# candidate-position pairs, x1 moves the average career score 37.9 -> 62.1 and
# leaves 11% at 100, not "everyone who qualifies". effectiveYears is
# relevance-weighted and age-decayed, so clearing 3 years of TENURE is not 3
# effective relevant years. Raise it back toward 2 to spread qualified
# candidates out again on the years axis.
# CAREER_DEPTH_STATED_MULTIPLIER=1
#
# Whether a JD may only RAISE the bar and never lower it below
# CAREER_DEPTH_TARGET_YEARS. This used to be welded to the multiplier -- the JD
# was read only when stated x multiplier exceeded the fixed target -- which made
# lowering the multiplier mean "ignore the JD" rather than "use the stated
# number": at x1 only 2 of 179 profiles exceed 8 years, so 177 seats would have
# used the house default while the UI reported a JD-derived target. Keep it off
# to honour the JD in both directions; turn it on for the old behaviour.
# CAREER_DEPTH_STATED_ONLY_ABOVE_FIXED=0
# Set to 0 to ignore stated requirements and always use the fixed target.
# CAREER_DEPTH_USE_STATED=1
#
# Clamps so a JD stating something absurd cannot produce an absurd target.
# CAREER_DEPTH_MIN_TARGET_YEARS=3
# CAREER_DEPTH_MAX_TARGET_YEARS=20
# CAREER_DEPTH_MIN_TARGET_ROWS=1
# CAREER_DEPTH_MAX_TARGET_ROWS=8
#
# How the two axes combine. Depth carries the score, breadth only modulates it by
# this fraction. This replaced min(depthYears, depthRows), whose stated rationale
# ("one long stint is capped by the rows axis") threw away the strongest evidence
# the criterion can receive: a candidate with 10.6 years as an IT Application
# Development Analyst scored 47 while support-only candidates scored 100. Of five
# shapes measured, this one separated genuine from spurious relevance by +22
# points; min() managed +2. 0 makes breadth irrelevant; 0.5 makes it as important
# as depth.
# CAREER_DEPTH_BREADTH_WEIGHT=0.25
#
# Concavity (Mincer form). Above 1 applies x^(1/gamma) to each axis -- the
# concave shape human-capital theory implies, and the reason the Mincer earnings
# function fits experience quadratically. DEFAULT 1 (linear) because it was
# measured and made THIS objective worse: diminishing returns lift the middle of
# the scale, and the middle is where long-but-irrelevant careers sit. The
# separation fell from +39 at gamma=1 to +30 at 1.5 and +24 at 2, and the corpus
# average rose from 29 to 42. Right for modelling what experience EARNS, wrong
# for deciding whether experience is RELEVANT. Kept configurable rather than
# deleted so the choice stays visible and re-testable.
# CAREER_DEPTH_CONCAVITY=1
#
# Human-capital depreciation, per year since a stint ENDED. 0.043 is the skill
# depreciation rate estimated in the literature (~4.3%/yr), not a tuned constant.
# Nothing decayed before this: a stint that ended in 2006 counted exactly as much
# as the one the candidate holds today, and CareerPair.isCurrent was recorded
# without ever reaching the score. Measured: widens the genuine-versus-spurious
# separation from +34 to +39. Set 0 to disable.
# CAREER_RECENCY_DECAY=0.043

# Parallel calls for the education aspect (exact-match / grounded Gemini per candidate)
EDUCATION_LLM_CONCURRENCY=4

# ── Education aspect (exact-match → grounded Gemini) ──
# The education criterion first tries a DETERMINISTIC token exact-match of the
# candidate's education level + major against the job profile's stated education
# requirement (extracted jobSpecification.education). On an exact match it scores
# with tiered thresholds — no model call:
#   candidate level HIGHER than required -> 100
#   candidate level EQUAL to required    ->  80   <- a full mark for "exactly
#                                                    meets", not a deduction
#   candidate level LOWER than required  ->  50
# That table is the ONLY rule. EDUCATION_EXACT_MATCH_SCORE is REMOVED and has no
# effect: it used to give every exact match one flat score, and was left behind as
# an unreachable fallback that made operators set a value that did nothing. Runs
# scored before the change kept that flat value, which is why some stored
# exact-match scores match no tier — lib/education-tier.ts re-derives and shows
# the tier for those without rewriting the score that actually fed TOPSIS.
# When there's no exact match, education is scored by GEMINI with "Grounding with
# Google Search" (temperature 0, topP 0, fixed rubric, JSON-only). If the JSON is
# missing/invalid the call is retried this many times, then education scores 0.
EDUCATION_LLM_MAX_RETRIES=2
# Before calling Gemini for a candidate, reuse the answer the LAST completed
# AHP+TOPSIS run of the same position got for them when every input the model
# reads is identical (education + major, requirement, position title, job purpose,
# responsibilities + indicators, system prompt, model settings). Saves grounding
# calls and makes identical inputs give identical scores. Default on; set false to
# ask the model for every candidate again. See src/education-reuse.ts.
# AHP_EDUCATION_REUSE=true
# Gemini API — REQUIRED for the grounded education scorer. There is NO fallback:
# the BERT-similarity path was removed (it over-scored irrelevant majors), so with
# no key every candidate whose education/major is not a literal token match of the
# requirement scores education = 0 with source "none". That reads as a measured
# zero in the ranking. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model + grounding tool. Use google_search for Gemini 2.x (google_search_retrieval
# for legacy 1.5). Grounding cannot be combined with responseSchema, so JSON shape
# is enforced by the prompt + a validating parser.
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_GROUNDING_TOOL=google_search
# GEMINI_ENABLE_GROUNDING=true
# GEMINI_TEMPERATURE=0
# GEMINI_TOP_P=0
# GEMINI_TIMEOUT_MS=60000

# ── Session concurrency ──
# How many scoring sessions may PROCESS at once. Anything above the cap stays
# queued ('running' with no worker) and the orphan sweeper starts it as a slot
# frees — this is what keeps Position Management's bulk add (one run per
# position, dozens at a time) from starting every AHP run simultaneously.
SCORING_MAX_CONCURRENT=2
# Orphan sweeper: re-dispatch 'running' sessions nothing is working on. Also the
# queue drain above. Set the interval to 0 to disable.
ORPHAN_SWEEP_INTERVAL_MS=10000
ORPHAN_SWEEP_GRACE_MS=15000
