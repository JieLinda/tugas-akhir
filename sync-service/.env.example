# ── DB MPMDS – Employee / Division / Department source (MSSQL) ──
DB_MPMDS_SERVER=localhost
DB_MPMDS_PORT=1433
DB_MPMDS_USER=sa
DB_MPMDS_PASSWORD=
DB_MPMDS_DATABASE=MPMDS

# ── DB MPMHRGA – Performance Appraisal source (MSSQL) ──
DB_MPMHRGA_SERVER=localhost
DB_MPMHRGA_PORT=1433
DB_MPMHRGA_USER=sa
DB_MPMHRGA_PASSWORD=
DB_MPMHRGA_DATABASE=PERFORMANCE_DB

# ── Target PostgreSQL ──
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/pulse

# ── External API ──
API_BASE_URL=https://dev-apigw.mpm-motor.com
API_CLIENT_ID=trainingedp
API_CLIENT_SECRET=
API_GRANT_TYPE=client_credentials
API_TOKEN_PATH=/mpm/token/api/1.0/login/trainingedp

# ── Candidate population ──
# Company → Tenant mappings are managed in the DB via the UI (sync_company_tenant_map table)
SYNC_SYSTEM_USER_ID=

# ── Scheduler (cron) ──
# Weekly full sync – defaults to every Monday at 01:00 WIB
SYNC_CRON_EXPRESSION=0 1 * * 1

# ── Local upload store ──
# Where files uploaded via the Sinkronisasi page are kept. This is a plain LOCAL
# directory, never a network share: uploading is the fallback for when the shared
# folder is unreachable or LOCAL_*_FOLDER is unset. A file here takes precedence
# over the same file on the shared folder.
# Relative paths resolve against the service's working directory (/app in Docker).
LOCAL_UPLOAD_FOLDER=uploads

# ── Source systems ──
# false = never contact MSSQL, the HR REST API or the shared folders (connection layer,
# cron and source routes all refuse). Uploads and everything derived from them keep
# working. For running away from the company network, e.g. a demo. Default true.
SOURCE_SYNC_ENABLED=true
